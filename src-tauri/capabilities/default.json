{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "What the main window may call: the session, recording and project commands.",
  "windows": ["main"],
  "permissions": [
    "allow-pty-spawn",
    "allow-pty-write",
    "allow-pty-resize",
    "allow-pty-kill",
    "allow-recording-mark",
    "allow-recording-current",
    "allow-recording-list",
    "allow-recording-read",
    "allow-project-list",
    "allow-project-add",
    "allow-project-relocate",
    "allow-project-remove"
  ]
}
