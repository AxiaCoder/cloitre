{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "What the main window may call: the session, recording, project and tab commands, listening to the events the app emits, and checking, downloading and installing an update.",
  "windows": ["main"],
  "permissions": [
    "allow-pty-spawn",
    "allow-pty-write",
    "allow-pty-resize",
    "allow-pty-kill",
    "allow-recording-enabled",
    "allow-recording-mark",
    "allow-recording-current",
    "allow-recording-list",
    "allow-recording-read",
    "allow-project-list",
    "allow-project-add",
    "allow-project-relocate",
    "allow-project-remove",
    "allow-project-select",
    "allow-project-set-marker",
    "allow-tab-open",
    "allow-tab-close",
    "allow-tab-activate",
    "allow-tab-set-title",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install"
  ]
}
